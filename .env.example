# Database (PostgreSQL)
DATABASE_URL=postgresql://sejiwa_user:sejiwa_pass_123@localhost:5432/sejiwa_titiwangsa_db
DATABASE_POOL_MAX=20

# Redis (Cache & Pub/Sub)
REDIS_URL=redis://localhost:6379/0

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Security & JWT
JWT_SECRET=sejiwa_titiwangsa_jwt_secret_key_min_32_chars_required_xyz_change_in_prod
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@sejiwa.my
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=noreply@sejiwa.my
SMTP_FROM_NAME=SEJIWA Titiwangsa Cafe

# Error Tracking (Optional)
SENTRY_DSN=

# ============================================================================
# SEJIWA CAFE SETTINGS
# ============================================================================

# Branch Information
CAFE_NAME=SEJIWA Titiwangsa
CAFE_CODE=SEJW-KL01
CAFE_PHONE=+60 3-4101 0101
CAFE_EMAIL=info@sejiwa.my
CAFE_ADDRESS=Lot 123, Jalan Titiwangsa, 50400 Kuala Lumpur

# Default Financial Settings
CAFE_CURRENCY=MYR
CAFE_TIMEZONE=Asia/Kuala_Lumpur
DEFAULT_BOOKING_DEPOSIT=100
DEFAULT_DECORATION_FEE=150
DEFAULT_NO_SHOW_GRACE_MIN=15
DEFAULT_CANCELLATION_CUTOFF_HOURS=24
DEFAULT_MODIFICATION_CUTOFF_HOURS=24

# Features
ENABLE_PROMO_CODES=true
ENABLE_COMMISSIONS=true
ENABLE_NOTIFICATIONS=true
ENABLE_NOTIFICATION_ALERTS=true
